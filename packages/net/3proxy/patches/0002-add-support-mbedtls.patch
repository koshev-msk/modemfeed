+  ssl_conn *c = (ssl_conn *)ctx;
+#ifdef _WIN32
+  int n = sso._send(sso.state, c->s, (const char *)buf, (int)len, 0);
+#else
+  ssize_t n = sso._send(sso.state, c->s, buf, len, 0);
+#endif
+  if (n >= 0)
+    return (int)n;
+#ifdef _WIN32
+  if (WSAGetLastError() == WSAEWOULDBLOCK)
+    return MBEDTLS_ERR_SSL_WANT_WRITE;
+#else
+  if (errno == EAGAIN || errno == EWOULDBLOCK)
+    return MBEDTLS_ERR_SSL_WANT_WRITE;
+#endif
+  return MBEDTLS_ERR_NET_SEND_FAILED;
+}
+
+static int mbed_recv_cb(void *ctx, unsigned char *buf, size_t len) {
+  ssl_conn *c = (ssl_conn *)ctx;
+#ifdef _WIN32
+  int n = sso._recv(sso.state, c->s, (char *)buf, (int)len, 0);
+#else
+  ssize_t n = sso._recv(sso.state, c->s, buf, len, 0);
+#endif
+  if (n >= 0)
+    return (int)n;
+#ifdef _WIN32
+  if (WSAGetLastError() == WSAEWOULDBLOCK)
+    return MBEDTLS_ERR_SSL_WANT_READ;
+#else
+  if (errno == EAGAIN || errno == EWOULDBLOCK)
+    return MBEDTLS_ERR_SSL_WANT_READ;
+#endif
+  return MBEDTLS_ERR_NET_RECV_FAILED;
+}
+
+static int ssl_wait(SOCKET s, short events) {
+  struct pollfd fds[1] = {{INVALID_SOCKET}};
+  fds[0].fd = s;
+  fds[0].events = events;
+  if (sso._poll(sso.state, fds, 1, pl->conf->timeouts[CONNECT_TO] * 1000) <= 0)
+    return 0;
+  return (fds[0].revents & (POLLIN | POLLOUT)) != 0;
+}
+
+static int do_handshake(ssl_conn *conn, int server, char **errSSL) {
+  int ret;
+  *errSSL = NULL;
+  do {
+    ret = mbedtls_ssl_handshake(conn->ssl);
+    if (ret == 0)
+      return 0;
+    if (ret == MBEDTLS_ERR_SSL_WANT_READ) {
+      if (!ssl_wait(conn->s, POLLIN))
+        break;
+    } else if (ret == MBEDTLS_ERR_SSL_WANT_WRITE) {
+      if (!ssl_wait(conn->s, POLLOUT))
+        break;
+    } else
+      break;
+  } while (1);
+  mbedtls_set_err(ret);
+  *errSSL = getSSLErr();
+  return ret;
+}
+
+int ssl_get_error(SSL_CONN connection) {
+  ssl_conn *conn = (ssl_conn *)connection;
+  return conn ? conn->last_err : MBEDTLS_ERR_SSL_INTERNAL_ERROR;
+}
+
+static int set_error(int ret, char **errSSL) {
+  if (ret) {
+    mbedtls_set_err(ret);
+    if (errSSL)
+      *errSSL = getSSLErr();
+  }
+  return ret;
+}
+
+static int parse_ciphers(const char *spec, int **out) {
+  char *copy, *p, *tok;
+  int *ids = NULL, n = 0, cap = 0, id;
+  if (!spec || !*spec) {
+    *out = NULL;
+    return 0;
+  }
+  copy = strdup(spec);
+  if (!copy)
+    return MBEDTLS_ERR_SSL_ALLOC_FAILED;
+  for (p = copy; *p; p++)
+    if (*p == ';' || *p == ':')
+      *p = ',';
+  tok = strtok(copy, ", ");
+  while (tok) {
+    id = mbedtls_ssl_get_ciphersuite_id(tok);
+    if (!id) {
+      free(ids);
+      free(copy);
+      return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;
+    }
+    if (n + 1 >= cap) {
+      cap = cap ? cap * 2 : 8;
+      ids = (int *)realloc(ids, (size_t)cap * sizeof(*ids));
+      if (!ids) {
+        free(copy);
+        return MBEDTLS_ERR_SSL_ALLOC_FAILED;
+      }
+    }
+    ids[n++] = id;
+    tok = strtok(NULL, ", ");
+  }
+  if (ids) {
+    ids[n] = 0;
+  }
+  free(copy);
+  *out = ids;
+  return 0;
+}
+
+static int build_alpn(const struct alpn *a, char ***out) {
+  unsigned int p = 0, n = 0, i;
+  char **list;
+  if (!a || !a->protos_len) {
+    *out = NULL;
+    return 0;
+  }
+  while (p < a->protos_len) {
+    unsigned int l = a->protos[p++];
+    if (!l || p + l > a->protos_len)
+      return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;
+    p += l;
+    n++;
+  }
+  list = calloc(n + 1, sizeof(*list));
+  if (!list)
+    return MBEDTLS_ERR_SSL_ALLOC_FAILED;
+  p = 0;
+  for (i = 0; i < n; i++) {
+    unsigned int l = a->protos[p++];
+    list[i] = malloc(l + 1);
+    if (!list[i]) {
+      while (i)
+        free(list[--i]);
+      free(list);
+      return MBEDTLS_ERR_SSL_ALLOC_FAILED;
+    }
+    memcpy(list[i], a->protos + p, l);
+    list[i][l] = 0;
+    p += l;
+  }
+  *out = list;
+  return 0;
+}
+
+static void free_alpn(char **list) {
+  int i;
+  if (!list)
+    return;
+  for (i = 0; list[i]; i++)
+    free(list[i]);
+  free(list);
+}
+
+static int set_versions(mbedtls_ssl_config *ctx, int minv, int maxv) {
+  /* mbedTLS 3.x supports TLS 1.2 and TLS 1.3. */
+  int min = minv ? minv : 0, max = maxv ? maxv : 0;
+  if (min && min < 0x0303)
+    return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;
+  if (max && max < 0x0303)
+    return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;
+  if (min == 0x0303)
+    mbedtls_ssl_conf_min_tls_version(ctx, MBEDTLS_SSL_VERSION_TLS1_2);
+  else if (min == 0x0304)
+    mbedtls_ssl_conf_min_tls_version(ctx, MBEDTLS_SSL_VERSION_TLS1_3);
+  if (max == 0x0303)
+    mbedtls_ssl_conf_max_tls_version(ctx, MBEDTLS_SSL_VERSION_TLS1_2);
+  else if (max == 0x0304)
+    mbedtls_ssl_conf_max_tls_version(ctx, MBEDTLS_SSL_VERSION_TLS1_3);
+  if (min && max && min > max)
+    return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;
+  return 0;
+}
+
+static int load_ca(mbedtls_x509_crt *chain, const char *file, const char *dir,
+                   const char *store) {
+  int ret = 0;
+  if (file)
+    ret = mbedtls_x509_crt_parse_file(chain, file);
+  if (ret < 0)
+    return ret;
+  if (dir) {
+    ret = mbedtls_x509_crt_parse_path(chain, dir);
+    if (ret < 0)
+      return ret;
+  }
+  if (store) {
+    /* mbedTLS has no OpenSSL-style OS trust-store API. Accept store as
+       either a PEM bundle or a directory, matching the other CA options. */
+    ret = mbedtls_x509_crt_parse_file(chain, store);
+    if (ret < 0)
+      ret = mbedtls_x509_crt_parse_path(chain, store);
+    if (ret < 0)
+      return ret;
+  }
+  return 0;
+}
+
+static mbedtls_x509_crt *new_cert(void) {
+  mbedtls_x509_crt *c = calloc(1, sizeof(*c));
+  if (c)
+    mbedtls_x509_crt_init(c);
+  return c;
+}
+
+static mbedtls_pk_context *new_key(void) {
+  mbedtls_pk_context *k = calloc(1, sizeof(*k));
+  if (k)
+    mbedtls_pk_init(k);
+  return k;
+}
+
+static mbedtls_x509_crt *getCert(const char *fname) {
+  mbedtls_x509_crt *c;
+  int ret;
+  if (!fname)
+    return NULL;
+  c = new_cert();
+  if (!c)
+    return NULL;
+  ret = mbedtls_x509_crt_parse_file(c, fname);
+  if (ret < 0) {
+    mbedtls_x509_crt_free(c);
+    free(c);
+    mbedtls_set_err(ret);
+    return NULL;
+  }
+  return c;
+}
+
+static mbedtls_pk_context *getKey(const char *fname) {
+  mbedtls_pk_context *k;
+  int ret;
+  if (!fname)
+    return NULL;
+  k = new_key();
+  if (!k)
+    return NULL;
+  ret = mbedtls_pk_parse_keyfile(k, fname, NULL, mbedtls_ctr_drbg_random,
+                                 &mbedtls_ctr_drbg);
+  if (ret < 0) {
+    mbedtls_pk_free(k);
+    free(k);
+    mbedtls_set_err(ret);
+    return NULL;
+  }
+  return k;
+}
+
+static int configure_ctx(mbedtls_ssl_config *ctx, SSL_CONFIG *config,
+                         int endpoint, mbedtls_x509_crt *cert,
+                         mbedtls_pk_context *key) {
+  int ret, *ids = NULL;
+  char **alpn = NULL;
+  ret = mbedtls_ssl_config_defaults(ctx, endpoint, MBEDTLS_SSL_TRANSPORT_STREAM,
+                                    MBEDTLS_SSL_PRESET_DEFAULT);
+  if (ret)
+    return ret;
+  mbedtls_ssl_conf_rng(ctx, mbedtls_ctr_drbg_random, &mbedtls_ctr_drbg);
+  ret = set_versions(
+      ctx,
+      endpoint == MBEDTLS_SSL_IS_CLIENT ? config->client_min_proto_version
+                                        : config->server_min_proto_version,
+      endpoint == MBEDTLS_SSL_IS_CLIENT ? config->client_max_proto_version
+                                        : config->server_max_proto_version);
+  if (ret)
+    return ret;
+
+  if (endpoint == MBEDTLS_SSL_IS_CLIENT) {
+    if (config->client_ciphersuites_ids)
+      ids = config->client_ciphersuites_ids;
+    else {
+      ret = parse_ciphers(config->client_ciphersuites
+                              ? config->client_ciphersuites
+                              : config->client_cipher_list,
+                          &ids);
+      if (ret)
+        return ret;
+      config->client_ciphersuites_ids = ids;
+    }
+    if (ids)
+      mbedtls_ssl_conf_ciphersuites(ctx, ids);
+    if (config->client_alpn_list)
+      alpn = config->client_alpn_list;
+    else {
+      ret = build_alpn(&config->client_alpn_protos, &alpn);
+      if (ret)
+        return ret;
+      config->client_alpn_list = alpn;
+    }
+    if (alpn)
+      mbedtls_ssl_conf_alpn_protocols(ctx, (const char **)alpn);
+    if (config->client_verify) {
+      mbedtls_ssl_conf_authmode(ctx, MBEDTLS_SSL_VERIFY_REQUIRED);
+      if (!config->client_ca_chain) {
+        config->client_ca_chain = new_cert();
+        if (!config->client_ca_chain)
+          return MBEDTLS_ERR_SSL_ALLOC_FAILED;
+      }
+      ret = load_ca(config->client_ca_chain, config->client_ca_file,
+                    config->client_ca_dir, config->client_ca_store);
+      if (ret)
+        return ret;
+      mbedtls_ssl_conf_ca_chain(ctx, config->client_ca_chain, NULL);
+    } else
+      mbedtls_ssl_conf_authmode(ctx, MBEDTLS_SSL_VERIFY_NONE);
+  } else {
+    if (config->server_ciphersuites_ids)
+      ids = config->server_ciphersuites_ids;
+    else {
+      ret = parse_ciphers(config->server_ciphersuites
+                              ? config->server_ciphersuites
+                              : config->server_cipher_list,
+                          &ids);
+      if (ret)
+        return ret;
+      config->server_ciphersuites_ids = ids;
+    }
+    if (ids)
+      mbedtls_ssl_conf_ciphersuites(ctx, ids);
+    if (config->server_verify) {
+      mbedtls_ssl_conf_authmode(ctx, MBEDTLS_SSL_VERIFY_REQUIRED);
+      if (!config->server_ca_chain) {
+        config->server_ca_chain = new_cert();
+        if (!config->server_ca_chain)
+          return MBEDTLS_ERR_SSL_ALLOC_FAILED;
+      }
+      ret = load_ca(config->server_ca_chain, config->server_ca_file,
+                    config->server_ca_dir, config->server_ca_store);
+      if (ret)
+        return ret;
+      mbedtls_ssl_conf_ca_chain(ctx, config->server_ca_chain, NULL);
+    } else
+      mbedtls_ssl_conf_authmode(ctx, MBEDTLS_SSL_VERIFY_NONE);
+  }
+  if (cert && key) {
+    ret = mbedtls_ssl_conf_own_cert(ctx, cert, key);
+    if (ret)
+      return ret;
+  }
+  return 0;
+}
+
+mbedtls_ssl_config *ssl_cli_ctx(SSL_CONFIG *config,
+                                mbedtls_x509_crt *server_cert,
+                                mbedtls_pk_context *server_key, char **errSSL) {
+  mbedtls_ssl_config *ctx = calloc(1, sizeof(*ctx));
+  int ret;
+  if (!ctx)
+    return NULL;
+  mbedtls_ssl_config_init(ctx);
+  ret = configure_ctx(ctx, config, MBEDTLS_SSL_IS_SERVER, server_cert,
+                      server_key);
+  if (ret) {
+    set_error(ret, errSSL);
+    mbedtls_ssl_config_free(ctx);
+    free(ctx);
+    return NULL;
+  }
+  return ctx;
+}
+
+static SSL_CONN ssl_new_conn(SOCKET s, SSL_CONFIG *config, int endpoint,
+                             mbedtls_ssl_config *ctx, char *hostname,
+                             char **errSSL) {
+  ssl_conn *conn = calloc(1, sizeof(*conn));
+  int ret;
+  if (!conn)
+    return NULL;
+  conn->s = s;
+  conn->ctx = ctx;
+  conn->ssl = calloc(1, sizeof(*conn->ssl));
+  if (!conn->ssl) {
+    free(conn);
+    return NULL;
+  }
+  mbedtls_ssl_init(conn->ssl);
+  ret = mbedtls_ssl_setup(conn->ssl, ctx);
+  if (ret) {
+    set_error(ret, errSSL);
+    ssl_conn_free(conn);
+    return NULL;
+  }
+  mbedtls_ssl_set_bio(conn->ssl, conn, mbed_send_cb, mbed_recv_cb, NULL);
+  if (endpoint == MBEDTLS_SSL_IS_CLIENT && hostname && *hostname) {
+    ret = mbedtls_ssl_set_hostname(conn->ssl, hostname);
+    if (ret) {
+      set_error(ret, errSSL);
+      ssl_conn_free(conn);
+      return NULL;
+    }
+  }
+  ret = do_handshake(conn, endpoint == MBEDTLS_SSL_IS_SERVER, errSSL);
+  if (ret) {
+    ssl_conn_free(conn);
+    return NULL;
+  }
+  conn->ctx = NULL; /* shared config is owned by SSL_CONFIG; temporary ctx is
+                       freed below by caller only if used */
+  return conn;
+}
+
+SSL_CONN ssl_handshake_to_server(SOCKET s, char *hostname, SSL_CONFIG *config,
+                                 SSL_CERT *server_cert, char **errSSL) {
+  ssl_conn *conn;
+  conn = (ssl_conn *)ssl_new_conn(s, config, MBEDTLS_SSL_IS_CLIENT,
+                                  config->srv_ctx, hostname, errSSL);
+  if (!conn)
+    return NULL;
+  if (server_cert) {
+    const mbedtls_x509_crt *peer = mbedtls_ssl_get_peer_cert(conn->ssl);
+    if (!peer) {
+      ssl_conn_free(conn);
+      return NULL;
+    }
+    mbedtls_x509_crt *copy = new_cert();
+    if (!copy ||
+        mbedtls_x509_crt_parse_der(copy, peer->raw.p, peer->raw.len) < 0) {
+      if (copy) {
+        mbedtls_x509_crt_free(copy);
+        free(copy);
+      }
+      ssl_conn_free(conn);
+      return NULL;
+    }
+    *server_cert = copy;
+  }
+  return conn;
+}
+
+SSL_CONN ssl_handshake_to_client(SOCKET s, SSL_CONFIG *config,
+                                 mbedtls_x509_crt *server_cert,
+                                 mbedtls_pk_context *server_key,
+                                 char **errSSL) {
+  mbedtls_ssl_config *tmp = NULL;
+  SSL_CONN conn;
+  if (!config->cli_ctx) {
+    tmp = ssl_cli_ctx(config, server_cert, server_key, errSSL);
+    if (!tmp)
+      return NULL;
+  }
+  conn = ssl_new_conn(s, config, MBEDTLS_SSL_IS_SERVER,
+                      config->cli_ctx ? config->cli_ctx : tmp, NULL, errSSL);
+  if (!conn && tmp) {
+    mbedtls_ssl_config_free(tmp);
+    free(tmp);
+  }
+  /* ssl_new_conn deliberately detaches ctx because shared configs are not
+     per-connection. For a temporary MITM config, retain it in conn. */
+  if (conn && tmp)
+    ((ssl_conn *)conn)->ctx = tmp;
+  return conn;
+}
+
+SSL_CONN dosrvcon(struct clientparam *param, SSL_CERT *cert) {
+  SSL_CONN c;
+  char *errSSL = NULL;
+  c = ssl_handshake_to_server(param->remsock, (char *)param->hostname, PCONF,
+                              cert, &errSSL);
+  if (!c) {
+    param->res = 8011;
+    param->srv->logfunc(param,
+                        (unsigned char *)"SSL handshake to server failed");
+    if (errSSL)
+      param->srv->logfunc(param, (unsigned char *)errSSL);
+  }
+  return c;
+}
+
+int domitm(struct clientparam *param) {
+  SSL_CERT server = NULL, fake = NULL;
+  SSL_CONN sc = NULL, cc = NULL;
+  char *err = NULL;
+  sc = dosrvcon(param, &server);
+  if (!sc)
+    return 1;
+  fake = ssl_copy_cert(server, PCONF);
+  _ssl_cert_free(server);
+  if (!fake) {
+    param->res = 8012;
+    param->srv->logfunc(param,
+                        (unsigned char *)"Failed to create certificate copy");
+    ssl_conn_free(sc);
+    return 2;
+  }
+  cc = ssl_handshake_to_client(
+      param->clisock, PCONF, fake,
+      PCONF->server_key ? PCONF->server_key : PCONF->CA_key, &err);
+  _ssl_cert_free(fake);
+  if (!cc) {
+    param->res = 8012;
+    param->srv->logfunc(param, (unsigned char *)"Handshake to client failed");
+    if (err)
+      param->srv->logfunc(param, (unsigned char *)err);
+    ssl_conn_free(sc);
+    return 3;
+  }
+  addSSL(param->clisock, cc, param->remsock, sc, param);
+  return 0;
+}
+
+int docli(struct clientparam *param) {
+  SSL_CONN c;
+  SSL_CERT cert = NULL;
+  unsigned char *hostname = param->hostname;
+  param->hostname = (unsigned char *)PCONF->client_sni;
+  c = dosrvcon(param, &cert);
+  param->hostname = hostname;
+  _ssl_cert_free(cert);
+  if (!c)
+    return 1;
+  addSSL(INVALID_SOCKET, NULL, param->remsock, c, param);
+  return 0;
+}
+
+#ifdef _WIN32
+static int WINAPI ssl_send(void *state, SOCKET s, const char *msg, int len,
+                           int flags) {
+#else
+static ssize_t ssl_send(void *state, SOCKET s, const void *msg, size_t len,
+                        int flags) {
+#endif
+  struct SSLsock *q = searchSSL(state, s);
+  if (q) {
+    int r = ssl_write(q->conn, (void *)msg, (int)len);
+    if (r < 0) {
+      int e = ssl_get_error(q->conn);
+      if (e == MBEDTLS_ERR_SSL_WANT_WRITE || e == MBEDTLS_ERR_SSL_WANT_READ) {
+        seterrno3(EAGAIN);
+        return -1;
+      }
+      seterrno3(EIO);
+    }
+    return r;
+  }
+  return sso._send(sso.state, s, msg, len, flags);
+}
+
+#ifdef _WIN32
+static int WINAPI ssl_recv(void *state, SOCKET s, char *msg, int len,
+                           int flags) {
+#else
+static ssize_t ssl_recv(void *state, SOCKET s, void *msg, size_t len,
+                        int flags) {
+#endif
+  struct SSLsock *q = searchSSL(state, s);
+  if (q) {
+    int r = ssl_read(q->conn, msg, (int)len);
+    if (r < 0) {
+      int e = ssl_get_error(q->conn);
+      if (e == MBEDTLS_ERR_SSL_WANT_READ || e == MBEDTLS_ERR_SSL_WANT_WRITE) {
+        seterrno3(EAGAIN);
+        return -1;
+      }
+      seterrno3(EIO);
+    }
+    return r;
+  }
+  return sso._recv(sso.state, s, msg, len, flags);
+}
+
+#ifdef _WIN32
+static int WINAPI ssl_sendto(void *state, SOCKET s, const char *msg, int len,
+                             int flags, const struct sockaddr *to, int tolen) {
+  return ssl_send(state, s, msg, len, flags);
+}
+static int WINAPI ssl_recvfrom(void *state, SOCKET s, char *msg, int len,
+                               int flags, struct sockaddr *from, int *fromlen) {
+  return ssl_recv(state, s, msg, len, flags);
+}
+#else
+static ssize_t ssl_sendto(void *state, SOCKET s, const void *msg, size_t len,
+                          int flags, const struct sockaddr *to,
+                          SASIZETYPE tolen) {
+  return ssl_send(state, s, msg, len, flags);
+}
+static ssize_t ssl_recvfrom(void *state, SOCKET s, void *msg, size_t len,
+                            int flags, struct sockaddr *from,
+                            SASIZETYPE *fromlen) {
+  return ssl_recv(state, s, msg, len, flags);
+}
+#endif
+
+static int WINAPI ssl_shutdown(void *state, SOCKET s, int how) {
+  delSSL(state, s);
+  return sso._shutdown(sso.state, s, how);
+}
+static int WINAPI ssl_closesocket(void *state, SOCKET s) {
+  delSSL(state, s);
+  return sso._closesocket(sso.state, s);
+}
+#ifdef _WIN32
+static int WINAPI ssl_poll(void *state, struct pollfd *fds, unsigned int nfds,
+                           int timeout) {
+#else
+static int ssl_poll(void *state, struct pollfd *fds, nfds_t nfds, int timeout) {
+#endif
+  unsigned int i;
+  int ret = 0;
+  struct SSLsock *q;
+  for (i = 0; i < nfds; i++) {
+    q = searchSSL(state, fds[i].fd);
+    if (q && (fds[i].events & POLLIN) && ssl_pending(q->conn)) {
+      fds[i].revents = POLLIN;
+      ret++;
+    } else
+      fds[i].revents = 0;
+  }
+  return ret ? ret : sso._poll(state, fds, nfds, timeout);
+}
+
+static void free_ctx_config(SSL_CONFIG *c) {
+  if (!c)
+    return;
+  free(c->client_ciphersuites_ids);
+  free(c->server_ciphersuites_ids);
+  free_alpn(c->client_alpn_list);
+  if (c->client_ca_chain) {
+    mbedtls_x509_crt_free(c->client_ca_chain);
+    free(c->client_ca_chain);
+  }
+  if (c->server_ca_chain) {
+    mbedtls_x509_crt_free(c->server_ca_chain);
+    free(c->server_ca_chain);
+  }
+}
