+static void *ssl_filter_open(void *idata, struct srvparam *srv) {
+  char fname[256], *errSSL = NULL;
+  SSL_CONFIG *sc = calloc(1, sizeof(*sc));
+  int ret;
+  if (!sc)
+    return NULL;
+  if (certcache)
+    sc->certcache = strdup(certcache);
+  sc->client_min_proto_version = client_min_proto_version;
+  sc->client_max_proto_version = client_max_proto_version;
+  sc->server_min_proto_version = server_min_proto_version;
+  sc->server_max_proto_version = server_max_proto_version;
+  sc->client_mode = client_mode;
+  sc->client_verify = client_verify;
+  sc->server_verify = server_verify;
+  if (client_ciphersuites)
+    sc->client_ciphersuites = strdup(client_ciphersuites);
+  if (server_ciphersuites)
+    sc->server_ciphersuites = strdup(server_ciphersuites);
+  if (client_cipher_list)
+    sc->client_cipher_list = strdup(client_cipher_list);
+  if (server_cipher_list)
+    sc->server_cipher_list = strdup(server_cipher_list);
+  if (client_sni)
+    sc->client_sni = strdup(client_sni);
+  if (client_ca_file)
+    sc->client_ca_file = strdup(client_ca_file);
+  if (client_ca_dir)
+    sc->client_ca_dir = strdup(client_ca_dir);
+  if (client_ca_store)
+    sc->client_ca_store = strdup(client_ca_store);
+  if (server_ca_file)
+    sc->server_ca_file = strdup(server_ca_file);
+  if (server_ca_dir)
+    sc->server_ca_dir = strdup(server_ca_dir);
+  if (server_ca_store)
+    sc->server_ca_store = strdup(server_ca_store);
+  if (client_alpn_protos.protos_len) {
+    sc->client_alpn_protos = client_alpn_protos;
+    sc->client_alpn_protos.protos = malloc(client_alpn_protos.protos_len);
+    if (sc->client_alpn_protos.protos)
+      memcpy(sc->client_alpn_protos.protos, client_alpn_protos.protos,
+             client_alpn_protos.protos_len);
+    else
+      sc->client_alpn_protos.protos_len = 0;
+  }
+  if (srvkey) {
+    sc->server_key = getKey(srvkey);
+    if (!sc->server_key)
+      return sc;
+  }
+  if (clikey) {
+    sc->client_key = getKey(clikey);
+    if (!sc->client_key)
+      return sc;
+  }
+
+  if (mitm) {
+    if (!server_ca_file) {
+      if (!certcache)
+        return sc;
+      snprintf(fname, sizeof(fname), "%s3proxy.pem", certcache);
+    }
+    sc->CA_cert = getCert(server_ca_file ? server_ca_file : fname);
+    if (!sc->CA_cert)
+      return sc;
+    if (!server_ca_key) {
+      if (!certcache)
+        return sc;
+      snprintf(fname, sizeof(fname), "%s3proxy.key", certcache);
+    }
+    sc->CA_key = getKey(server_ca_key ? server_ca_key : fname);
+    if (!sc->CA_key)
+      return sc;
+    if (!sc->server_key && sc->certcache) {
+      snprintf(fname, sizeof(fname), "%sserver.key", sc->certcache);
+      sc->server_key = getKey(fname);
+    }
+    sc->mitm = 1;
+  }
+  if (cli) {
+    if (clicert) {
+      sc->client_cert = getCert(clicert);
+      if (!sc->client_cert || !sc->client_key)
+        return sc;
+    }
+    sc->cli = 1;
+  }
+  if (serv) {
+    if (!srvcert || !sc->server_key)
+      return sc;
+    sc->server_cert = getCert(srvcert);
+    if (!sc->server_cert)
+      return sc;
+    sc->cli_ctx = calloc(1, sizeof(*sc->cli_ctx));
+    if (!sc->cli_ctx)
+      return sc;
+    mbedtls_ssl_config_init(sc->cli_ctx);
+    ret = configure_ctx(sc->cli_ctx, sc, MBEDTLS_SSL_IS_SERVER, sc->server_cert,
+                        sc->server_key);
+    if (ret) {
+      set_error(ret, &errSSL);
+      fprintf(stderr, "failed to create server context: %s\n",
+              errSSL ? errSSL : "");
+      return sc;
+    }
+    sc->serv = 1;
+  }
+  if (mitm || cli) {
+    sc->srv_ctx = calloc(1, sizeof(*sc->srv_ctx));
+    if (!sc->srv_ctx)
+      return sc;
+    mbedtls_ssl_config_init(sc->srv_ctx);
+    ret = configure_ctx(sc->srv_ctx, sc, MBEDTLS_SSL_IS_CLIENT, sc->client_cert,
+                        sc->client_key);
+    if (ret) {
+      set_error(ret, &errSSL);
+      fprintf(stderr, "failed to create client context: %s\n",
+              errSSL ? errSSL : "");
+      sc->mitm = sc->cli = 0;
+    }
+  }
+  if (mitm || cli || serv) {
+    srv->so._send = ssl_send;
+    srv->so._recv = ssl_recv;
+    srv->so._sendto = ssl_sendto;
+    srv->so._recvfrom = ssl_recvfrom;
+    srv->so._shutdown = ssl_shutdown;
+    srv->so._closesocket = ssl_closesocket;
+    srv->so._poll = ssl_poll;
+  }
+#ifdef WITHSPLICE
+  srv->usesplice = 0;
+#endif
+  return sc;
+}
