+static int build_san_list_mbedtls(const mbedtls_x509_sequence *seq, mbedtls_x509_san_list **out)
+{
+	const mbedtls_x509_sequence *p;
+	mbedtls_x509_san_list *head = NULL, *tail = NULL, *item;
+	int ret;
+	*out = NULL;
+	for(p = seq; p; p = p->next){
+		item = calloc(1, sizeof(*item));
+		if(!item){ ret = MBEDTLS_ERR_X509_ALLOC_FAILED; goto fail; }
+		ret = mbedtls_x509_parse_subject_alt_name(&p->buf, &item->node);
+		if(ret){ free(item); goto fail; }
+		if(!head) head = item; else tail->next = item;
+		tail = item;
+	}
+	*out = head;
+	return 0;
+fail:
+	while(head){
+		item = head->next;
+		mbedtls_x509_free_subject_alt_name(&head->node);
+		free(head);
+		head = item;
+	}
+	return ret;
+}
+
+static void free_san_list_mbedtls(mbedtls_x509_san_list *list)
+{
+	while(list){
+		mbedtls_x509_san_list *next = list->next;
+		mbedtls_x509_free_subject_alt_name(&list->node);
+		free(list);
+		list = next;
+	}
+}
