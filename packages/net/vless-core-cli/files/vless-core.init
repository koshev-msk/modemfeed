#!/bin/sh /etc/rc.common

USE_PROCD=1
START=90
STOP=10

PROG=/usr/bin/vless-core
CONF=vless-core

start_service() {
	local enabled uri listen_port routing tls_mode

	config_load "$CONF"
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get uri main uri
	config_get listen_port main listen_port 1080
	config_get routing main routing
	config_get tls_mode main tls_mode strict

	[ -n "$uri" ] || {
		logger -t vless-core "uri is not set"
		return 1
	}

	procd_open_instance
	procd_set_param command "$PROG" --uri "$uri" --listen-port "$listen_port"
	[ -n "$routing" ] && procd_append_param command --routing "$routing"
	procd_set_param env VLESS_TLS_MODE="$tls_mode"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}
