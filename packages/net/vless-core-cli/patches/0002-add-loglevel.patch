+/* Minimum level: debug=0 info=1 warning=2 error=3.
+ * Set by --log-level (vc_log_set_level), fallback VLESS_CORE_LOG_LEVEL. */
+static int g_log_level=-1;
+
+int vc_log_set_level(const char *name) {
+    int level;
+    if (!name) return -1;
+    if (!strcmp(name,"debug")) level=0;
+    else if (!strcmp(name,"info")) level=1;
+    else if (!strcmp(name,"warning") || !strcmp(name,"warn")) level=2;
+    else if (!strcmp(name,"error")) level=3;
+    else return -1;
+    g_log_level=level; return 0;
+}
+
+static int log_threshold(void) {
+    if (g_log_level < 0 && vc_log_set_level(getenv("VLESS_CORE_LOG_LEVEL"))) g_log_level=0;
+    return g_log_level;
+}
+
 #define DEFINE_LOG_FUNCTION(function_name, level_name, category)               \
     void function_name(const char *component, const char *format, ...) {       \
+        if ((int)(category) < log_threshold()) return;                         \
         va_list arguments;                                                     \
@@ -292,4 +313,7 @@
     va_list arguments; va_start(arguments,format); vc_log_vmessage(level,"probe",format,arguments,4); va_end(arguments);
 }
 
-void vc_log_probe(int success,const char *text) { log_probe_message(success ? "I" : "W","%s",text); }
+void vc_log_probe(int success,const char *text) {
+    if (success && log_threshold() > 0) return;
+    log_probe_message(success ? "I" : "W","%s",text);
+}
