# Example, disabled by default.
#
# 'interface'  logical netifd interface to shape (e.g. lan). Its device
#              (e.g. br-lan) is found automatically; download = device
#              egress, upload = device ingress redirected to an IFB
#              named ifb-<device> that is created automatically.
#              Re-applied whenever the interface changes state.
# 'bypass'     networks that go to the local class instead of the
#              per-client classes (IPv4 and IPv6 allowed).
#
# Optional class sizing (defaults shown):
#   total 1000Mbit, local_rate 50Mbit, local_ceil 500Mbit,
#   down_total 400Mbit, up_total 300Mbit,
#   default_rate 1Mbit, default_ceil 15Mbit
#   leaf_qdisc 'fq_codel limit 1024 flows 128' ('none' to disable)
#
# Clients refer to a shaper by its logical interface name
# ("option shaper"). Clients are matched in file order: put specific
# hosts before wide subnets.

config shaper 'lan'
	option enabled '0'
	option interface 'lan'
	list bypass '192.168.1.0/24'

config client 'laptop'
	option shaper 'lan'
	list address '192.168.1.100'
	list address '2001:db8:1::100'
	option down_rate '1Mbit'
	option down_ceil '50Mbit'
	option up_rate '1Mbit'
	option up_ceil '20Mbit'
