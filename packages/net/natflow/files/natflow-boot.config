config natflow 'main'
	option enabled '1'
	option debug '3'
	option hwnat '0'
	# option hwnat_wed_disabled '0'
	# option delay_pkts '0'
	# option go_slowpath_if_no_qos '0'
	# option ifname_group_type '0'
	# list ifname_group 'eth0'
	# option tc_classid_mode '1'

config zone
	option type 'lan'
	option id '1'
	option ifname 'br-lan'

config zone
	option type 'wan'
	option id '2'
	option ifname 'pppoe-wan'	# можно префикс: 'eth+'

