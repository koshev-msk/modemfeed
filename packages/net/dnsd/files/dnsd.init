#!/bin/sh /etc/rc.common

START=30
USE_PROCD=1
PROG=/usr/sbin/dnsd

validate_dnsd_section() {
	uci_validate_section dnsd dnsd "${1}" \
		'enabled:bool:0' \
		'url:string' \
		'bootstrap:list(string)' \
		'listen:string:127.0.0.1' \
		'port:port:5053' \
		'proxy:string' \
		'pin:string' \
		'debug:bool:0'
}

dnsd_instance() {
	local enabled url bootstrap listen port proxy pin debug

	validate_dnsd_section "$1" || {
		echo "validation failed"
		return 1
	}

	[ "$enabled" = 0 ] && return

	[ -n "$url" ] || {
		logger -t dnsd -p daemon.err "$1: option url is not set"
		return 1
	}

	procd_open_instance "$1"
	procd_set_param command "$PROG" --url "$url" --listen "$listen" --port "$port"

	# bootstrap servers are only used to resolve the host name of the url
	[ -n "$bootstrap" ] && procd_append_param command --bootstrap "$(echo $bootstrap | tr ' ' ',')"
	[ -n "$proxy" ] && procd_append_param command --proxy "$proxy"
	[ -n "$pin" ] && procd_append_param command --pin "$pin"

	# procd needs a process in the foreground, debug also logs every query
	if [ "$debug" = 1 ]; then
		procd_append_param command --debug
	else
		procd_append_param command --foreground
	fi

	# retry forever: at boot the bootstrap server may not be reachable yet
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	config_load dnsd
	config_foreach dnsd_instance dnsd
}

service_triggers() {
	procd_add_reload_trigger dnsd
	procd_add_validation validate_dnsd_section
}

reload_service() {
	stop
	start
}
