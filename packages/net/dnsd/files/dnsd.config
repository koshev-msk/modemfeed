config dnsd 'main'
	option enabled '0'
	# DoH endpoint (RFC 8484), required, for example:
	# option url 'https://1.1.1.1/dns-query'
	option url ''
	# DNS servers used only to resolve the host name of the url:
	# IP, IP:PORT, IP#PORT or [IPv6]:PORT; not needed when url has an IP address
	list bootstrap '1.1.1.1'
	# dnsmasq: list server '127.0.0.1#5053' and option noresolv '1' in /etc/config/dhcp
	option listen '127.0.0.1'
	option port '5053'
	# option proxy 'socks5h://127.0.0.1:1080'
	# option pin 'sha256//base64-of-the-server-public-key='
	option debug '0'
