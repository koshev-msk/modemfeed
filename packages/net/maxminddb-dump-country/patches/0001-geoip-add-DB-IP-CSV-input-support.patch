     }
 
     if(stat(filename,&st)) {
-        perror("mmdb file:");
+        perror("input file:");
         exit(1);
     }
     if(!opt_xtgeo && !opt_csv && !opt_asn) {
         fprintf(stderr,"%s: -o or -c or -a is required!\n",progname);
         exit(1);
     }
+    if(opt_dbip && !S_ISREG(st.st_mode)) {
