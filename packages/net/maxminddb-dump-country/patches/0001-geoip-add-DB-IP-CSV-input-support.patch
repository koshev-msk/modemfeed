+        exit(1);
+    }
     if(opt_asn && (opt_xtgeo  || opt_csv)) {
         fprintf(stderr,"%s: cant use -A with -o or -c\n",progname);
         exit(1);
@@ -426,43 +640,55 @@ int main(int argc, char **argv)
         output_dir[l+2] = '\0';
     }
 
-    status = MMDB_open(filename, MMDB_MODE_MMAP, &mmdb);
+    if(opt_dbip) {
