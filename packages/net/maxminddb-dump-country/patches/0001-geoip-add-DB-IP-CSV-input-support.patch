         case '4': opt_6 = 0; break;
         case '6': opt_4 = 0; break;
         case 'v': opt_v++; break;
@@ -394,17 +596,29 @@ int main(int argc, char **argv)
         filename = strdup(argv[optind]);
     } else {
         filename = opt_asn ? asn_name:country_name;
-        if(access(filename,R_OK)) usage();
